APP_NAME="Lume Locações"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Fortaleza

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Banco de dados. O padrão é SQLite (arquivo database/database.sqlite): funciona sem instalar nada.
DB_CONNECTION=sqlite

# Para usar MySQL, troque as linhas acima por:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=lume_locacoes
# DB_USERNAME=root
# DB_PASSWORD=

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# Sites que podem chamar esta API pelo navegador (separados por vírgula)
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173

# API Python do assistente de ajuda (pasta ia-api na raiz do repositório)
IA_API_URL=http://127.0.0.1:8001
# Opcional: se definir, defina o mesmo valor em IA_API_TOKEN na API Python
IA_API_TOKEN=

# Primeiro acesso: o seeder cria o usuário master com estes dados.
# Fora de produção, sem estas variáveis, vale master@lume.com / lume1234 (e contas de exemplo).
# Em produção, sem MASTER_SENHA (8+ caracteres) nenhum usuário é criado.
MASTER_EMAIL=master@lume.com
MASTER_SENHA=lume1234
